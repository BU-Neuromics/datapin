    given-names: Adam
    affiliation: Boston University
  # orcid: "https://orcid.org/0000-0000-0000-0000"   # TODO: add
repository-code: "https://github.com/BU-Neuromics/datapin"
url: "https://github.com/BU-Neuromics/datapin#readme"
license: MIT
keywords:
  - research data management
  - FAIR data
  - data publication
  - DOI
  - Zenodo
  - InvenioRDM
  - Dataverse
  - data versioning
  - reproducibility
